{
  "name": "assetmanager",
  "version": "1.0.0",
  "scripts": {
    "build": "browserify flowers_oop.mjs -t [ babelify --presets [@babel/preset-env] --global ] --outfile bundle.js"
  },
  "dependencies": {
    "browserify": "17.0.1",
    "three": "0.183.2",
    "glob": "13.0.6",
    "debug": "4.4.3"
  },
  "overrides": {
    "elliptic": "file:elliptic"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "babelify": "10.0.0"
  },
  "browserify": {
    "transform": [
      ["babelify", {
        "presets": ["@babel/preset-env"],
        "global": true
      }]
    ]
  }
}
